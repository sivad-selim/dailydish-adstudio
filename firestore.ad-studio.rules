rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isDailyDishOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'mydailydishapp@gmail.com';
    }

    function validTranslation(value) {
      return value is map && value.keys().hasOnly(['title', 'description'])
        && value.title is string && value.description is string;
    }
    match /post-pages/{pageId} {
      allow read: if isDailyDishOwner();
      allow create, update: if isDailyDishOwner()
        && request.resource.data.keys().hasOnly(['postId', 'name', 'translations', 'format', 'theme', 'background', 'backgroundAssetId', 'properties', 'ownerEmail', 'createdAt', 'updatedAt'])
        && request.resource.data.postId is string
        && request.resource.data.translations.keys().hasOnly(['en', 'fr', 'pt'])
        && validTranslation(request.resource.data.translations.en)
        && validTranslation(request.resource.data.translations.fr)
        && validTranslation(request.resource.data.translations.pt)
        && pageId in getAfter(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.pageIds;
      allow delete: if isDailyDishOwner()
        && (!existsAfter(/databases/$(database)/documents/posts/$(resource.data.postId))
          || !(pageId in getAfter(/databases/$(database)/documents/posts/$(resource.data.postId)).data.pageIds));
    }
    match /post-folders/{folderId} {
      allow read, create, update, delete: if isDailyDishOwner();
    }

    match /gallery-folders/{folderId} {
      allow read, create, update, delete: if isDailyDishOwner();
    }

    match /publication-plans/{planId} {
      allow read, create, update, delete: if isDailyDishOwner();
    }

    match /posts/{postId} {
      allow read, delete: if isDailyDishOwner();
      allow create, update: if isDailyDishOwner()
        && request.resource.data.keys().hasOnly(['folderId', 'pageIds', 'ownerEmail', 'createdAt', 'updatedAt'])
        && request.resource.data.folderId is string
        && request.resource.data.pageIds is list
        && request.resource.data.pageIds.size() >= 1
        && request.resource.data.pageIds.size() <= 10
        && request.resource.data.pageIds.toSet().size() == request.resource.data.pageIds.size();
    }

    match /instagram-publications/{publicationId} {
      allow read: if isDailyDishOwner();
      allow write: if false;
    }

    match /publication-settings/{id} {
      allow read: if isDailyDishOwner();
      allow write: if false;
    }
    match /publication-schedules/{id} {
      allow read: if isDailyDishOwner();
      allow write: if false;
    }
    match /publication-reports/{id} {
      allow read: if isDailyDishOwner();
      allow write: if false;
    }
    match /publication-schedule-attempts/{id} {
      allow read: if isDailyDishOwner();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
